generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String   @default("User")
  password          String? // null for OAuth-only users
  avatar            String?
  isPremium         Boolean  @default(false)
  createdAt         DateTime @default(now())
  strictnessLevel   Int      @default(1)
  totalFocusSeconds Int      @default(0)

  oauthAccounts    OAuthAccount[]
  sessions         FocusSession[]
  breaks           Break[]
  blockedApps      BlockedApp[]
  strictness       Strictness?
  themes           UserTheme?
  youtubeAllowlist YoutubeAllowlist[]
  youtubePlaylists YoutubePlaylist[]
  achievements     UserAchievement[]
  schedules        Schedule[]
}

model OAuthAccount {
  id                String  @id @default(uuid())
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model FocusSession {
  id        String        @id @default(uuid())
  startTime DateTime      @default(now())
  endTime   DateTime?
  duration  Int? // in seconds
  status    SessionStatus @default(ACTIVE)
  createdAt DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  breaks             Break[]
  strictnessOverride Strictness?
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Strictness {
  id                 String  @id @default(uuid())
  maxBreaks          Int     @default(3)
  baseAdDuration     Int     @default(30) // seconds
  adIncreasePerBreak Int     @default(10) // seconds added after each break
  noBreaksAllowed    Boolean @default(false) // premium only

  // global → userId set, sessionId null
  // per session → sessionId set (premium only)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?       @unique
  session   FocusSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Break {
  id         String   @id @default(uuid())
  takenAt    DateTime @default(now())
  adDuration Int // how long the ad was at this break number
  skipped    Boolean  @default(false)

  sessionId String?
  session   FocusSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlockedApp {
  id         String  @id @default(uuid())
  appName    String
  browserUrl String?
  isBlocked  Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appName])
}

model Theme {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  quoteSet    String[] // array of quotes shown during break
  exerciseSet String[] // array of exercises shown during break
  isPremiun   Boolean  @default(false)

  userThemes UserTheme[]
}

model UserTheme {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id])
}

model YoutubeAllowlist {
  id        String   @id @default(uuid())
  videoId   String
  url       String
  title     String?
  thumbnail String?
  addedAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model YoutubePlaylist {
  id         String   @id @default(uuid())
  playlistId String
  url        String
  title      String?
  addedAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playlistId])
}

model Achievement {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  condition   String // e.g. "complete_5_sessions", "no_breaks_3_days"
  icon        String?

  userAchievements UserAchievement[]
}

model UserAchievement {
  id         String   @id @default(uuid())
  unlockedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model Schedule {
  id         String  @id @default(uuid())
  label      String
  startTime  String
  endTime    String
  daysOfWeek Int[]
  isActive   Boolean @default(true)
  timezone   String  @default("Asia/Kolkata")
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
