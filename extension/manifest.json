{
  "manifest_version": 3,
  "name": "Foci",
  "version": "1.0.0",
  "description": "Block distracting apps and stay focused",

  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],

  "host_permissions": [
    "https://foci.digital/*",
    "http://localhost:5173/*",
    "http://localhost:3000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}